# Copy this file to .env and fill in the values, or run `npm run setup`.
# Do NOT put real secrets here — .env.example is committed to git.

GOOGLE_API_KEY=
VIDEO_OUTPUT_DIR=
VEO_MODEL=
VEO_RESOLUTION=
VEO_ASPECT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Автоотправка готовых роликов из `npm run voiceover` (по желанию).
# VibePost: URL Edge Function ingest-video и service_role-ключ Supabase.
# ВНИМАНИЕ: service_role-ключ мощный — держи .env в секрете (он в .gitignore).
VIBEPOST_INGEST_URL=
VIBEPOST_KEY=

# Optional polish knobs (safe defaults if left empty)
VEO_SPEED=
VEO_MUSIC_VOLUME=
VEO_MUSIC=
