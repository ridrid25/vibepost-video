# Copy this file to .env and fill in the values, or run `npm run setup`.
# Do NOT put real secrets here — .env.example is committed to git.

GOOGLE_API_KEY=
VIDEO_OUTPUT_DIR=
VEO_MODEL=
VEO_RESOLUTION=
VEO_ASPECT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Автоотправка готовых роликов из `npm run voiceover` (по желанию).
# VibePost: URL Edge Function ingest-video и отдельный узкий ingest-секрет.
# Не используйте здесь service_role-ключ Supabase.
VIBEPOST_INGEST_URL=https://rjtyjybwygfkdekdzqbm.supabase.co/functions/v1/ingest-video
VIBEPOST_INGEST_SECRET=

# Content Brigade: read/write only through the narrow Edge Function secret.
# Never put SUPABASE_SERVICE_ROLE_KEY in this project.
VIBEPOST_BRIGADE_URL=https://rjtyjybwygfkdekdzqbm.supabase.co/functions/v1/content-brigade
VIBEPOST_BRIGADE_SECRET=

# Optional polish knobs (safe defaults if left empty)
VEO_SPEED=
VEO_MUSIC_VOLUME=
VEO_MUSIC=
