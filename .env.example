# Copy this file to .env and fill in the values, or run `npm run setup`.
# Do NOT put real secrets here — .env.example is committed to git.

GOOGLE_API_KEY=
VIDEO_OUTPUT_DIR=
VEO_MODEL=
VEO_RESOLUTION=
VEO_ASPECT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Автоотправка готовых роликов из `npm run voiceover` (по желанию).
# VibePost: URL Edge Function ingest-video и секрет приёмника.
# Секрет лежит в Vault проекта VibePost под именем vibepost_ingest_secret.
# Это НЕ service_role-ключ: им можно только положить ролик во «Входящие».
VIBEPOST_INGEST_URL=
VIBEPOST_INGEST_SECRET=

# Optional polish knobs (safe defaults if left empty)
VEO_SPEED=
VEO_MUSIC_VOLUME=
VEO_MUSIC=
